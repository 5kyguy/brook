{
    "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
    "productName": "Brook",
    "version": "0.1.1",
    "identifier": "dev.skyguy.brook",
    "build": {
        "beforeDevCommand": "bun run dev",
        "devUrl": "http://localhost:5173",
        "beforeBuildCommand": "bun run build",
        "frontendDist": "../frontend/dist"
    },
    "app": {
        "windows": [],
        "security": {
            "capabilities": ["default"],
            "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost ws://localhost:5173 http://localhost:5173; img-src 'self' asset: http://asset.localhost blob: data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
        }
    },
    "bundle": {
        "active": true,
        "targets": ["appimage"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ]
    }
}
